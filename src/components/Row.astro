---
interface Props {
  years: string;
}

const { years } = Astro.props;
---

<div class="grid grid-cols-1 gap-y-1 sm:grid-cols-[minmax(6rem,1fr)_minmax(0,62ch)_minmax(6rem,1fr)] sm:gap-x-6 py-[1.15rem] border-t border-rule-soft first:border-t-0">
  <span class="text-xs text-meta tabular-nums sm:pt-1">{years}</span>
  <div><slot /></div>
</div>
