---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { profile } from '../data/cv.ts';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    const pa = a.data.priority ?? Infinity;
    const pb = b.data.priority ?? Infinity;
    if (pa !== pb) return pa - pb;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.summary}
>
  <Nav />

  <main>
    <section class="border-b border-rule">
      <div class="max-w-3xl mx-auto px-6 py-16 text-center">
        <div
          class="mx-auto mb-7 w-[82px] h-[82px] rounded-full bg-rule flex items-center justify-center text-xs text-meta shadow-[0_0_0_7px_var(--color-paper),0_0_0_8px_var(--color-rule)]"
        >
          photo
        </div>
        <h1 class="font-display font-extrabold text-4xl leading-tight max-w-[16ch] mx-auto">
          Hi, I'm Rafael
        </h1>
        <p class="font-display font-extrabold text-4xl leading-tight max-w-[20ch] mx-auto text-accent">
          I build and document software
        </p>
        <p class="text-secondary text-[15px] leading-relaxed max-w-[62ch] mx-auto mt-6">
          {profile.heroTagline}
        </p>
        <div class="flex gap-2.5 justify-center mt-7 text-[13.5px]">
          <a href="/projects" class="bg-ink text-paper px-[18px] py-[9px]">View projects</a>
          <a href="/resume" class="border border-rule-soft px-[18px] py-[9px]">View resume</a>
        </div>
      </div>
    </section>

    {featured.length > 0 && (
      <section>
        <div class="max-w-3xl mx-auto px-6 py-12">
          <div class="flex items-baseline">
            <p class="text-[11px] tracking-[0.13em] uppercase text-meta">Selected projects</p>
            <a href="/projects" class="text-[11px] text-accent ml-auto">All projects →</a>
          </div>

          <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-8 gap-y-9 mt-6">
            {featured.map((project) => (
              <a href={`/projects/${project.id}`} class="block">
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt}
                  class="w-full aspect-[4/3] object-cover"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 640px) 320px, 100vw"
                />
                <p class="font-display font-medium text-[17px] mt-3.5">{project.data.title}</p>
                <p class="text-[13px] leading-relaxed text-secondary text-justify mt-1.5">{project.data.description}</p>
                <p class="text-[12px] text-muted mt-2">{project.data.tech.join(' · ')}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
